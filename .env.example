# ==========================================
# FallGuard AI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME=FallGuard AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Security & Authentication
# Generate a unique value for each installation with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated explicit origins, no wildcards in production)
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration
DATABASE_URL=sqlite:///./fall_guard.db

# Machine Learning & Inference
MODEL_PATH=data/models/fall_detection_model.joblib
METRICS_PATH=reports/model_metrics.json
SAMPLING_RATE=50
WINDOW_SIZE_SECONDS=2.56
WINDOW_OVERLAP=0.50

# Fall Detection Confidence & Risk Thresholds
FALL_CONFIDENCE_HIGH=0.85
FALL_CONFIDENCE_MEDIUM=0.60
ALERT_COOLDOWN_SECONDS=45
FALL_CONFIRMATION_TIMEOUT_SECONDS=15.0

# Emergency Provider (mock = simulation; twilio = live Twilio SMS dispatch)
EMERGENCY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email Dispatch Configuration (optional SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

